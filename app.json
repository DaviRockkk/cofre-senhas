{
  "expo": {
    "name": "Null",
    "slug": "null",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0F19"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSFaceIDUsageDescription": "Permitir biometria para acessar seu cofre de senhas com segurança."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B0F19"
      },
      "package": "com.davirockkk.null"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "bdc1f50f-3b62-4eb8-abb7-9d5ea792bc6c"
      }
    },
    "plugins": [
      "expo-sharing",
      "expo-status-bar",
      "expo-local-authentication"
    ]
  }
}
