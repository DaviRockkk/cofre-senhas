    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#0B0F19"
      },
      "package": "com.davirockkk.cofresenhas",
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "updates": {
      "url": "https://u.expo.dev/bdc1f50f-3b62-4eb8-abb7-9d5ea792bc6c"
    },
    "runtimeVersion": "2.0.0",
    "extra": {
      "eas": {
        "projectId": "bdc1f50f-3b62-4eb8-abb7-9d5ea792bc6c"
      }
    },
    "plugins": [
      "expo-updates",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Permitir biometria para acessar seu cofre de senhas com segurança."
        }
      ],
      "expo-sharing",
      "expo-status-bar"
    ],
    "owner": "davirockkk"
  }
